#!/usr/bin/env sh
# Layer 1: Pre-commit quality gate
# Blocks commits that fail C# formatting, ESLint, or Prettier checks.

set -e

echo "🔍 Running pre-commit quality checks..."

# ── Check 1: C# formatting ──────────────────────────────────────────────────
echo ""
echo "  [1/3] dotnet format (C# verify-no-changes)..."
if ! dotnet format src/RecipeHub.Api/ --verify-no-changes --severity error 2>&1; then
  echo ""
  echo "  ❌ C# formatting violations detected."
  echo "     Run: dotnet format src/RecipeHub.Api/"
  exit 1
fi
echo "  ✅ C# formatting OK"

# ── Check 2: TypeScript ESLint ──────────────────────────────────────────────
echo ""
echo "  [2/3] ESLint (TypeScript, zero warnings)..."
if ! (cd src/RecipeHub.Web && npx eslint . --max-warnings 0 2>&1); then
  echo ""
  echo "  ❌ ESLint violations detected."
  echo "     Run: cd src/RecipeHub.Web && npx eslint . --fix"
  exit 1
fi
echo "  ✅ ESLint OK"

# ── Check 3: Prettier formatting ────────────────────────────────────────────
echo ""
echo "  [3/3] Prettier (check mode)..."
if ! (cd src/RecipeHub.Web && npx prettier --check "src/**/*.{ts,tsx,css}" 2>&1); then
  echo ""
  echo "  ❌ Prettier formatting violations detected."
  echo "     Run: cd src/RecipeHub.Web && npx prettier --write \"src/**/*.{ts,tsx,css}\""
  exit 1
fi
echo "  ✅ Prettier OK"

echo ""
echo "✅ All quality checks passed. Proceeding with commit."
